---
import Analytics from "../../components/Analytics.astro";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/global.css";
import { getPublishedArticles } from "../../lib/articles";

const articles = (await getPublishedArticles()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const pageUrl = new URL("/articles", Astro.site).toString();
const title = "Articles | Reginal Campbell";
const description = "Essays by Reginal Campbell on leadership, hiring and careers, AI and technology, and the personal side of work.";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <Analytics />
  <meta charset="UTF-8">
  <meta name="color-scheme" content="dark">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Reginal Campbell">
  <link rel="canonical" href={pageUrl}>
  <meta name="robots" content="index, follow">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={pageUrl}>
  <link rel="alternate" type="application/rss+xml" title="Reginal Campbell | Articles RSS" href="/rss.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body class="antialiased">
  <a href="#articles-main" class="skip-link">Skip to main content</a>

  <SiteNav active="articles" />

  <main id="articles-main" style="max-width:860px;margin:0 auto;padding:calc(var(--nav-height, 64px) + 48px) 24px 96px;">
    <header class="mb-12">
      <span class="text-amber-400 font-mono text-sm uppercase tracking-wider">Articles</span>
      <h1 class="text-3xl md:text-4xl font-bold mt-2">Essays on leadership, hiring, and AI, and the life around the work.</h1>
    </header>

    {articles.length === 0 ? (
      <p class="text-neutral-400">No articles published yet — check back soon.</p>
    ) : (
      <ul class="space-y-6">
        {articles.map((article) => (
          <li class="bg-neutral-900/40 rounded-2xl border border-white/8 p-6">
            <a href={`/articles/${article.id}`} class="block hover:opacity-90 transition">
              <span class="text-neutral-500 text-xs font-mono uppercase tracking-widest">
                {article.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
              </span>
              <h2 class="text-xl font-bold mt-2">{article.data.title}</h2>
              <p class="text-neutral-400 text-sm mt-2 leading-relaxed">{article.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</body>
</html>
