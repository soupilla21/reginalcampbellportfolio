---
import "../../styles/global.css";
import { getCollection } from "astro:content";

const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const pageUrl = new URL("/articles", Astro.site).toString();
const title = "Articles — Reginal Campbell";
const description = "Writing on enterprise transformation, AI governance, and delivery from Reginal Campbell.";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-32FSF2EFEW"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-32FSF2EFEW');
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Reginal Campbell">
  <link rel="canonical" href={pageUrl}>
  <meta name="robots" content="index, follow">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={pageUrl}>
  <link rel="alternate" type="application/rss+xml" title="Reginal Campbell — Articles RSS" href="/rss.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body class="antialiased">
  <a href="#articles-main" class="skip-link">Skip to main content</a>

  <nav id="main-nav" aria-label="Main navigation">
    <div class="inner">
      <div class="flex items-center gap-2 min-w-0">
        <a href="/" class="text-lg font-bold tracking-tight bg-gradient-to-r from-white to-gray-400 bg-clip-text text-transparent whitespace-nowrap">REGINAL CAMPBELL</a>
        <span class="hidden md:inline text-neutral-500 font-mono text-sm">|</span>
        <span class="hidden md:inline text-sm font-mono text-neutral-400 truncate">AI &amp; Data Strategy</span>
      </div>
      <div class="flex items-center gap-5 text-sm font-medium flex-shrink-0">
        <a href="/#case-study" class="nav-link">Work</a>
        <a href="/#delivery-portfolio" class="nav-link">Portfolio</a>
        <a href="/#governance" class="nav-link">Governance</a>
        <a href="/#innovation-lab" class="nav-link">Lab</a>
        <a href="/#point-of-view" class="nav-link">POV</a>
        <a href="/articles" class="nav-link nav-active">Articles</a>
        <a href="/#contact" class="nav-link">Contact</a>
        <a href="https://briefing.reginalcampbell.com" class="nav-link">Ask the AI</a>
      </div>
    </div>
  </nav>

  <main id="articles-main" style="max-width:860px;margin:0 auto;padding:calc(var(--nav-height, 64px) + 48px) 24px 96px;">
    <header class="mb-12">
      <span class="text-amber-400 font-mono text-sm uppercase tracking-wider">Articles</span>
      <h1 class="text-3xl md:text-4xl font-bold mt-2">Writing on Enterprise Transformation &amp; AI Governance.</h1>
    </header>

    {articles.length === 0 ? (
      <p class="text-neutral-400">No articles published yet — check back soon.</p>
    ) : (
      <ul class="space-y-6">
        {articles.map((article) => (
          <li class="bg-neutral-900/40 rounded-2xl border border-white/8 p-6">
            <a href={`/articles/${article.id}`} class="block hover:opacity-90 transition">
              <span class="text-neutral-500 text-xs font-mono uppercase tracking-widest">
                {article.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
              </span>
              <h2 class="text-xl font-bold mt-2">{article.data.title}</h2>
              <p class="text-neutral-400 text-sm mt-2 leading-relaxed">{article.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</body>
</html>
