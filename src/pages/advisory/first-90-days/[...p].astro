---
// /advisory/first-90-days: "90 Days to a Decision-Ready Technology Portfolio".
//
// Two routes through one page: an executive view (about three minutes:
// the Day 60 decision, the plan, the delivery path, what success looks like,
// evidence from real work) and an optional deep dive (the operating model
// and all twelve artifacts).
//
// Publication gate: see src/data/playbooks/index.ts. "review" never builds
// on production; "unlisted" builds but is noindex and out of the sitemap.
// Content lives in src/data/playbooks/first-90-days.ts; this file is layout.
import PageLayout from "../../../layouts/PageLayout.astro";
import { isBuiltStatus } from "../../../data/playbooks";
import {
  meta, documents, hero, routes, principles, programs, portfolioNote, roles, steering, phases,
  deliveryPath, indicators, raciRoles, raci, raciNote, tierNote, ragRows, ragMeaning, ragRules,
  thresholds, routing, raid, raidNote, exec, decisions, forums, weeklyStatus, scorecard, readiness,
  artifacts, evidence, agreement, disclosure, together,
} from "../../../data/playbooks/first-90-days";
import { contactHref } from "../../../config/site";
import "../../../styles/governance-playbook.css";

export function getStaticPaths() {
  return isBuiltStatus(meta.status) ? [{ params: { p: undefined } }] : [];
}

const slug = meta.slug;
const path = `/advisory/${slug}`;
const isPublic = meta.status === "public";
const fileHref = (name: string) => `${path}/files/${name}`;
const ragLabel = { g: "Green", a: "Yellow", r: "Red" } as const;
const roleNames = Object.fromEntries(roles.map((r) => [r.key, r.name]));
const cap = steering.capacity;
const fmt = (n: number) => n.toLocaleString("en-US");
const demand = cap.b + cap.c; // 1,680
const scaleMax = 1800; // widest bar: capacity with productive contractor hours
const w = (n: number) => `${((n / scaleMax) * 100).toFixed(2)}%`;
const recommended = steering.options.find((o) => o.recommended)!;

const navItems = [
  { id: "decision", label: "Day 60 decision" },
  { id: "plan", label: "Plan" },
  { id: "together", label: "Working together" },
  { id: "delivery", label: "Delivery path" },
  { id: "success", label: "Day 90" },
  { id: "evidence", label: "Evidence" },
  { id: "operating-model", label: "Operating model" },
];
---
<PageLayout
  title={meta.title}
  description={meta.description}
  path={path}
  nav="minimal"
  noindex={!isPublic}
  width={1180}
  event={{ name: "playbook_view", params: { playbook: slug, status: meta.status } }}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: hero.title,
    description: meta.description,
    url: `https://reginalcampbell.com${path}`,
    author: { "@id": "https://reginalcampbell.com/#person" },
    isAccessibleForFree: true,
    about: ["Technical program management", "Technology portfolio governance", "Healthcare supply chain technology"],
  }}
>
  <div class="gp" id="top" data-gp-root data-slug={slug}>
    <nav class="gp-nav" aria-label="Page sections">
      <div class="gp-nav-inner">
        <a href="#top" class="gp-nav-home">90-day plan</a>
        <ol class="gp-nav-list">
          {navItems.map((n) => (
            <li><a href={`#${n.id}`} data-gp-navlink={n.id} data-ga-event="playbook_nav" data-ga-playbook={slug} data-ga-section={n.id}>{n.label}</a></li>
          ))}
        </ol>
        <a href="#documents" class="gp-nav-dl" data-ga-event="playbook_nav" data-ga-playbook={slug} data-ga-section="documents">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 1.5h5.5L13 5v9.5H4z"/><path d="M9.5 1.5V5H13"/></svg>
          Documents
        </a>
      </div>
    </nav>

    {meta.status === "review" && (
      <p class="gp-review-flag" role="note"><strong>Review build.</strong> This page is not published. It is excluded from the production site until its status changes.</p>
    )}

    <!-- ══ OPENING ══ -->
    <header class="gp-hero2">
      <div class="gp-hero2-text">
        <p class="gp-eyebrow">{hero.eyebrow} <span class="gp-chip">Illustrative scenario</span></p>
        <h1 class="gp-title">{hero.title}</h1>
        <p class="gp-subtitle2">{hero.subtitle}</p>
        <ol class="gp-outcomes" aria-label="What the first 90 days deliver">
          {hero.outcomes.map((o) => (
            <li><a href={o.href}><span class="gp-out-day">Day {o.day}</span><span class="gp-out-word">{o.word}</span><span class="gp-out-text">{o.text}</span></a></li>
          ))}
        </ol>
      </div>
      <aside class="gp-teaser" aria-labelledby="teaser-title">
        <p id="teaser-title" class="gp-teaser-title">{hero.decisionTeaser.title}</p>
        <div class="gp-teaser-stats">
          {hero.decisionTeaser.stats.map((s, i) => (
            <p class={i === 0 ? "is-short" : "is-buffer"}><span class="gp-teaser-v">{s.value}</span><span class="gp-teaser-l">{s.label}</span></p>
          ))}
        </div>
        <div class="gp-teaser-bar" aria-hidden="true">
          <span class="gp-tb-cap" style={`width:${((cap.available / demand) * 100).toFixed(2)}%`}></span>
          <span class="gp-tb-short"></span>
        </div>
        <p class="gp-teaser-cap gp-small">{fmt(demand)} hours of demand · {fmt(cap.available)} hours of capacity ({cap.team} engineers at {cap.focus * 100}% focus)</p>
        <a href="#decision" class="gp-btn" data-ga-event="playbook_entry" data-ga-playbook={slug} data-ga-mode="decision">Make the Day 60 call <span aria-hidden="true">↓</span></a>
      </aside>

      <div class="gp-routes">
        {routes.map((r, i) => (
          <a href={r.href} class={`gp-route${i === 0 ? " is-primary" : ""}`} data-ga-event="playbook_entry" data-ga-playbook={slug} data-ga-mode={i === 0 ? "executive" : "deep-dive"}>
            <span class="gp-route-label">{r.label} <span aria-hidden="true">→</span></span>
            <span class="gp-route-time">{r.time}</span>
            <span class="gp-route-text">{r.text}</span>
          </a>
        ))}
      </div>
      <p class="gp-onepager-link">Short on time? <a href={fileHref(documents[0].file)} target="_blank" rel="noopener" class="gp-link" data-gp-view={fileHref(documents[0].file)} data-gp-view-title={documents[0].title} data-ga-event="playbook_document_open" data-ga-playbook={slug} data-ga-file="summary-hero">Read the one-page summary</a> <span class="gp-muted">(PDF)</span></p>
      <p class="gp-scenario-note">{meta.preparedFor} · {hero.scenarioNote}</p>
    </header>

    <!-- ══ YOUR SEAT ══ -->
    <section class="gp-seat" id="seat" aria-labelledby="seat-title">
      <div class="gp-seat-head">
        <h2 id="seat-title" class="gp-seat-title">Your seat at the table</h2>
        <p class="gp-small gp-muted">Pick the role you usually hold. Your parts of the page get marked.</p>
      </div>
      <div class="gp-rolepick" role="group" aria-label="Choose a governance role" data-gp-roles>
        <button type="button" aria-pressed="true" data-role="all">All roles</button>
        {roles.map((r) => <button type="button" aria-pressed="false" data-role={r.key} data-ga-event="playbook_role_select" data-ga-role={r.key}>{r.name}</button>)}
      </div>
      <ul class="gp-rolecards">
        {roles.map((r) => (
          <li class="gp-rolecard" data-role-row={r.key}>
            <p class="gp-rc-name">{r.name}</p>
            <p class="gp-rc-ex">{r.examples}</p>
            <dl>
              <div><dt>You give</dt><dd>{r.give}</dd></div>
              <div><dt>You get</dt><dd>{r.get}</dd></div>
              <div><dt>You decide at</dt><dd>{r.decide}</dd></div>
            </dl>
          </li>
        ))}
      </ul>
      <p class="gp-role-status gp-small" aria-live="polite" data-gp-role-status></p>
    </section>

    <!-- ══ EXECUTIVE VIEW ══ -->

    <!-- 1. The Day 60 decision -->
    <section class="gp-section gp-decide" id="decision" aria-labelledby="decision-title" data-gp-section>
      <div class="gp-phase-head gp-reveal">
        <p class="gp-kicker gp-kicker-warm">The Day 60 decision <span class="gp-sample">Illustrative</span></p>
        <h2 id="decision-title" class="gp-h2 gp-h2-wide">{steering.question}</h2>
      </div>

      <div class="gp-decide-grid gp-reveal">
        <div>
          <ul class="gp-list">{steering.situation.map((s) => <li>{s}</li>)}</ul>
          <p class="gp-small gp-muted gp-mt">{steering.cause}</p>
        </div>
        <div class="gp-mini gp-portfolio-mini">
          <p class="gp-viz-title">The illustrative portfolio</p>
          <ul>
            {programs.map((p) => (
              <li><span class="gp-prog-key">{p.key}</span><span><strong>{p.name}</strong><br /><span class="gp-muted gp-small">{p.note}</span></span></li>
            ))}
          </ul>
          <p class="gp-small gp-muted">{portfolioNote}</p>
        </div>
      </div>

      <div class="gp-choose" data-gp-choose>
        <p class="gp-choose-q" id="choose-q">What would you approve?</p>
        <div class="gp-choices" role="group" aria-labelledby="choose-q">
          {steering.options.map((o) => (
            <button type="button" class="gp-choice" aria-pressed="false" aria-controls={`opt-${o.key}`} data-gp-choice={o.key} data-ga-event="playbook_decision_choice" data-ga-choice={o.key}>
              <span class="gp-choice-n">Option {o.n}</span>
              <span class="gp-choice-name">{o.name}</span>
              <span class="gp-choice-tag">{o.tagline}</span>
            </button>
          ))}
        </div>
        <p class="gp-choose-hint gp-small gp-muted" data-gp-choose-hint>Pick one to see what it costs, who has to approve it, and what happens if it goes wrong. There's no trick answer.</p>

        {steering.options.map((o) => (
          <article class={`gp-optpanel${o.recommended ? " is-rec" : ""}`} id={`opt-${o.key}`} data-gp-optpanel={o.key} aria-live="polite">
            <header class="gp-optpanel-head">
              <p class="gp-opt-n2">Option {o.n}</p>
              <h3 class="gp-optpanel-name">{o.name}: {o.tagline.toLowerCase()}</h3>
            </header>
            <p class="gp-optpanel-short">{o.short}</p>
            <figure class="gp-optbars" aria-label={`Hours for option ${o.n}`}>
              <div class="gp-cap-row">
                <span class="gp-cap-l">Work in window</span>
                <span class="gp-cap-bar">
                  {o.bars.b > 0 && <span class="gp-cap-b" style={`width:${w(o.bars.b)}`}>B {fmt(o.bars.b)}</span>}
                  {o.bars.c > 0 && <span class="gp-cap-c" style={`width:${w(o.bars.c)}`}>C {fmt(o.bars.c)}</span>}
                </span>
              </div>
              <div class="gp-cap-row">
                <span class="gp-cap-l">Capacity</span>
                <span class="gp-cap-bar">
                  <span class="gp-cap-avail" style={`width:${w(Math.min(o.bars.capacity, cap.available))}`}>{fmt(cap.available)}</span>
                  {o.bars.capacity > cap.available && <span class="gp-cap-buffer" style={`width:${w(o.bars.capacity - cap.available)}`}>+{cap.contract}</span>}
                </span>
              </div>
              <p class="gp-cap-legend">
                {(() => {
                  const used = o.bars.b + o.bars.c;
                  const left = o.bars.capacity - used;
                  return o.bars.c === 0
                    ? <span>{fmt(left)} hours left over, short of the {fmt(cap.c)} C needs. C waits about 6 weeks.</span>
                    : <span>{fmt(left)}-hour buffer</span>;
                })()}
              </p>
            </figure>
            <dl class="gp-optfacts">
              <div><dt>Schedule</dt><dd>{o.schedule}</dd></div>
              <div><dt>Cost</dt><dd>{o.cost}</dd></div>
              <div><dt>Risk</dt><dd>{o.risk}</dd></div>
              <div><dt>Who must approve</dt><dd>{o.approvers}</dd></div>
              <div><dt>Fallback trigger</dt><dd>{o.fallback}</dd></div>
              <div><dt>Reversible?</dt><dd>{o.reversible}</dd></div>
            </dl>
            <p class="gp-optpanel-take">{o.consequence}</p>
          </article>
        ))}

        <button type="button" class="gp-reveal-rec" data-gp-show-rec data-ga-event="playbook_decision_choice" data-ga-choice="show-recommendation">Just show me your recommendation</button>

        <section class="gp-recbox" id="recommendation" data-gp-rec aria-labelledby="rec-title">
          <p class="gp-kicker gp-kicker-warm">My recommendation</p>
          <h3 id="rec-title" class="gp-rec-head">Option {recommended.n}: {recommended.name.toLowerCase()}</h3>
          <p class="gp-rec-text">{steering.recommendation.replace(/^Option \d\.\s*/, "")}</p>
          <div class="gp-rec-grid">
            <div>
              <h4 class="gp-h5">What I'd ask for</h4>
              <ul class="gp-asks">{steering.asks.map((a) => <li><strong>{a.who}:</strong> {a.ask}</li>)}</ul>
            </div>
            <div>
              <h4 class="gp-h5">Assumptions I'd test first</h4>
              <ul class="gp-list">{steering.assumptions.map((a) => <li>{a}</li>)}</ul>
            </div>
            <div>
              <h4 class="gp-h5">Within 24 hours</h4>
              <ul class="gp-checks">{steering.after.map((a) => <li>{a}</li>)}</ul>
            </div>
          </div>
          <p class="gp-small gp-muted gp-mt"><strong>If nobody decides on Day 60:</strong> {steering.noDecision}</p>
          <p class="gp-small gp-mt"><a href="#art-preread" class="gp-link">See the full steering pre-read</a> · <a href="#art-log" class="gp-link">See the decision log</a></p>
        </section>
      </div>
    </section>

    <!-- 2. The 90-day plan at a glance -->
    <section class="gp-section" id="plan" aria-labelledby="plan-title" data-gp-section>
      <div class="gp-phase-head gp-reveal">
        <p class="gp-kicker">The 90-day plan</p>
        <h2 id="plan-title" class="gp-h2">Clarity, then decisions, then confidence</h2>
      </div>
      <ol class="gp-plan gp-reveal">
        {phases.map((p, i) => (
          <li class="gp-plan-col">
            <p class="gp-plan-days"><span class="gp-phase-n">{i + 1}</span>{p.days} · <strong>{p.band}</strong></p>
            <h3 class="gp-plan-title">{p.title}</h3>
            <p class="gp-plan-out">{p.outcome}</p>
            <p class="gp-plan-output"><span>Output</span>{p.output}</p>
            <p class="gp-plan-gives"><span>What this gives you</span>{p.gives}</p>
          </li>
        ))}
      </ol>
      <p class="gp-small gp-muted gp-mt">Inputs and mechanisms for each phase are in the <a href="#operating-model" class="gp-link">operating model</a>.</p>
    </section>

    <!-- 2b. How this works with the team already here -->
    <section class="gp-section" id="together" aria-labelledby="together-title" data-gp-section>
      <div class="gp-phase-head gp-reveal">
        <p class="gp-kicker">Working together</p>
        <h2 id="together-title" class="gp-h2">{together.title}</h2>
        <p class="gp-body">{together.lede}</p>
      </div>
      <div class="gp-together gp-reveal">
        {together.blocks.map((b) => (
          <article class="gp-tg" id={`together-${b.key}`}>
            <p class="gp-tg-kicker">{b.kicker}</p>
            <h3 class="gp-tg-title">{b.title}</h3>
            <ul class="gp-checks">{b.points.map((t) => <li>{t}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="gp-tools gp-reveal"><span class="gp-tools-k">Tools</span>{together.tools}</p>
    </section>

    <!-- 3. Technical delivery path -->
    <section class="gp-section" id="delivery" aria-labelledby="delivery-title" data-gp-section>
      <div class="gp-phase-head gp-reveal">
        <p class="gp-kicker">Technical delivery path <span class="gp-sample">Illustrative</span></p>
        <h2 id="delivery-title" class="gp-h2">I govern the dependencies, not just the dates</h2>
        <p class="gp-body">Every release in this portfolio runs through the same four steps. Each has an owner, a measurable definition of done, and a rule for what happens when it slips. Select a step.</p>
      </div>
      <div class="gp-tabs gp-path" data-gp-tabs>
        <div class="gp-pathlist" role="tablist" aria-label="Technical delivery path">
          {deliveryPath.map((n, i) => (
            <button type="button" role="tab" id={`path-tab-${n.key}`} aria-controls={`path-${n.key}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} class={`gp-node${n.ai ? " has-ai" : ""}`} data-ga-event="playbook_path_node" data-ga-node={n.key}>
              <span class="gp-node-n">{i + 1}</span>
              <span class="gp-node-name">{n.name}</span>
              {n.ai && <span class="gp-node-ai">Includes AI controls</span>}
            </button>
          ))}
        </div>
        {deliveryPath.map((n, i) => (
          <div class="gp-panel gp-nodepanel" id={`path-${n.key}`} role="tabpanel" aria-labelledby={`path-tab-${n.key}`} data-gp-panel>
            <h3 class="gp-panel-h"><span class="gp-node-n">{i + 1}</span>{n.name}</h3>
            <dl class="gp-nodefacts">
              <div><dt>Owner</dt><dd>{n.owner}</dd></div>
              <div><dt>Depends on</dt><dd>{n.dependsOn}</dd></div>
              <div><dt>Done when</dt><dd>{n.done}</dd></div>
              <div><dt>If it slips</dt><dd>{n.slips}</dd></div>
            </dl>
          </div>
        ))}
      </div>

      <div class="gp-indicators gp-reveal">
        <p class="gp-h5">Delivery indicators I'd report alongside status</p>
        <ul>
          {indicators.map((x) => <li><span class="gp-ind-v">{x.value}</span><span class="gp-ind-n">{x.name}</span><span class="gp-ind-t">{x.text}</span></li>)}
        </ul>
        <p class="gp-small gp-muted">The point of these: to challenge a delivery forecast, not just report it.</p>
      </div>
    </section>

    <!-- 4. What success looks like at Day 90 -->
    <section class="gp-section" id="success" aria-labelledby="success-title" data-gp-section>
      <div class="gp-phase-head gp-reveal">
        <p class="gp-kicker">What success looks like at Day 90</p>
        <h2 id="success-title" class="gp-h2">Leadership makes the call with evidence, not optimism</h2>
      </div>
      <div class="gp-pair gp-reveal">
        <figure class="gp-artifact gp-onepager" id="art-exec-full" aria-labelledby="exec-cap">
          <figcaption class="gp-art-head">
            <span class="gp-art-n">Artifact 5</span>
            <span id="exec-cap" class="gp-art-name">Executive one-pager · Day 90</span>
            <span class="gp-sample">Illustrative</span>
          </figcaption>
          <p class="gp-ask"><span>Decision needed</span>{exec.decision}</p>
          <ul class="gp-exec-progs">
            {exec.programs.map((x) => {
              const prog = programs.find((q) => q.key === x.key)!;
              return (
                <li>
                  <span class={`gp-dot gp-${x.rag}`} aria-hidden="true"></span>
                  <span><strong>{x.key}. {prog.name}</strong><span class="sr-only"> ({ragLabel[x.rag]})</span><br /><span class="gp-muted">{x.line}</span></span>
                  <span class="gp-exec-conf">{x.confidence} <span aria-label={x.trend === "↑" ? "improving" : "steady"}>{x.trend}</span></span>
                </li>
              );
            })}
          </ul>
          <div class="gp-exec-grid">
            <div><h4 class="gp-h5">Value at risk</h4><p>{exec.valueAtRisk}</p></div>
            <div><h4 class="gp-h5">Top three risks</h4><ol class="gp-list">{exec.risks.map((r) => <li>{r.text} <span class="gp-muted">Owner: {r.owner}.</span></li>)}</ol></div>
            <div><h4 class="gp-h5">What changed since Steering 2</h4><p>{exec.changed}</p></div>
          </div>
          <ul class="gp-score">
            {exec.scorecard.map((s) => <li><span class="gp-score-area">{s.area}</span><span class="gp-score-v">{s.value}</span><span class="gp-score-t">{s.text}</span></li>)}
          </ul>
        </figure>
        <div class="gp-side">
          <div class="gp-mini">
            <h3 class="gp-mini-h">Four calls, decided against the criteria</h3>
            <dl class="gp-calls">
              <div><dt>Proceed</dt><dd>Criteria met and controls in place.</dd></div>
              <div><dt>Pivot</dt><dd>The evidence favors a different approach.</dd></div>
              <div><dt>Slow</dt><dd>Capacity or adoption is short, so scope is sequenced.</dd></div>
              <div><dt>Stop</dt><dd>Criteria still unmet after one revision.</dd></div>
            </dl>
          </div>
          <div class="gp-mini">
            <h3 class="gp-mini-h">Then a governance retro</h3>
            <p class="gp-small">Cut any meeting that didn't produce a decision. Measure decision turnaround. Adjust the cadence. Governance should get lighter after Day 90, not heavier.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Evidence from my work -->
    <section class="gp-section" id="evidence" aria-labelledby="evidence-title" data-gp-section>
      <div class="gp-phase-head gp-reveal">
        <p class="gp-kicker">Evidence from my work</p>
        <h2 id="evidence-title" class="gp-h2">I've done this work at national scale in healthcare</h2>
      </div>
      <article class="gp-evidence gp-reveal">
        <div class="gp-ev-main">
          <p class="gp-ev-org">{evidence.org}</p>
          <h3 class="gp-ev-title">{evidence.title}</h3>
          <p class="gp-ev-role">{evidence.role}</p>
          <h4 class="gp-h5 gp-mt">The challenge</h4>
          <p>{evidence.challenge}</p>
          <h4 class="gp-h5 gp-mt">What I did</h4>
          <ul class="gp-list">{evidence.did.map((d) => <li>{d}</li>)}</ul>
          <p class="gp-callout">{evidence.link}</p>
          <p class="gp-small gp-mt"><a href={evidence.href} class="gp-link">Read the full case study</a></p>
        </div>
        <ul class="gp-ev-results" aria-label="Results">
          {evidence.results.map((r) => <li><span class="gp-ev-v">{r.value}</span><span class="gp-ev-l">{r.label}</span></li>)}
        </ul>
      </article>
    </section>

    <!-- Close of the executive view -->
    <section class="gp-close2" aria-labelledby="close-title">
      <p class="gp-kicker">The principle behind the plan</p>
      <h2 id="close-title" class="gp-quote">{agreement.close}</h2>
      <p class="gp-invite">{agreement.invitation}</p>
      <p class="gp-small gp-muted">That's the executive view. Everything below is optional supporting evidence.</p>
    </section>

    <!-- ══ DEEP DIVE ══ -->
    <section class="gp-section gp-deep" id="operating-model" aria-labelledby="om-title" data-gp-section>
      <div class="gp-deep-banner gp-reveal">
        <p class="gp-kicker">Optional deep dive</p>
        <h2 id="om-title" class="gp-h2">Explore the operating model</h2>
        <p class="gp-body">The working agreement, each phase in detail, and the twelve artifacts behind the plan. Open what matters to you; none of it is required reading.</p>
        <ul class="gp-principles2">
          {principles.map((p) => <li><strong>{p.label}</strong><span>{p.text}</span></li>)}
        </ul>
      </div>

      <div class="gp-agree gp-reveal" id="agreement">
        <div>
          <h3 class="gp-imo-h">What you can hold me to</h3>
          <ul class="gp-checks">{agreement.commitments.map((c) => <li>{c}</li>)}</ul>
        </div>
        <div>
          <h3 class="gp-imo-h">What I'd propose we agree on</h3>
          <ul class="gp-list">{agreement.proposals.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>

      <h3 class="gp-deep-h">Each phase in detail</h3>
      <div class="gp-phasedetail">
        {phases.map((p, i) => (
          <details class="gp-pd">
            <summary><span class="gp-phase-n">{i + 1}</span><span><strong>{p.days} · {p.band}:</strong> {p.title}</span></summary>
            <div class="gp-imo">
              <div class="gp-imo-col"><h4 class="gp-imo-h">Input</h4><ul>{p.input.map((t) => <li>{t}</li>)}</ul></div>
              <div class="gp-imo-col"><h4 class="gp-imo-h">Mechanism</h4><ul>{p.mechanism.map((t) => <li>{t}</li>)}</ul></div>
              <div class="gp-imo-col gp-imo-out"><h4 class="gp-imo-h">Output</h4><p>{p.output}</p></div>
            </div>
          </details>
        ))}
      </div>

      <h3 class="gp-deep-h" id="artifacts">Twelve artifacts, all filled in</h3>
      <p class="gp-small gp-muted gp-deep-sub">These are examples of what good looks like, not a system to install. Where an equivalent already exists, I'd use it. Every example uses the same illustrative portfolio and numbers; if you picked a role above, yours are marked.</p>
      <ol class="gp-gallery">
        {artifacts.map((a) => (
          <li class="gp-card" id={a.id} data-roles={a.roles.join(" ")}>
            <details>
              <summary data-ga-event="playbook_artifact_open" data-ga-artifact={a.id}>
                <span class="gp-card-n">{String(a.n).padStart(2, "0")}</span>
                <span class="gp-card-name">{a.name}</span>
                <span class="gp-badge" data-gp-badge hidden>You receive this</span>
                <span class="gp-card-meta"><span>For: {a.who}</span><span>When: {a.when}</span><span>Supports: {a.supports}</span></span>
              </summary>
              <div class="gp-card-body">
                {a.id === "art-raci" && (
                  <>
                    <p class="gp-small gp-muted"><abbr title="Responsible">R</abbr> does the work · <abbr title="Accountable">A</abbr> decides (one per row) · <abbr title="Consulted">C</abbr> consulted · <abbr title="Informed">I</abbr> informed</p>
                    <div class="gp-scroll" tabindex="0" role="region" aria-label="Decision rights matrix, scrolls horizontally">
                      <table class="gp-table gp-raci">
                        <thead><tr><th scope="col">Decision</th>{raciRoles.map((r) => <th scope="col">{r}</th>)}</tr></thead>
                        <tbody>
                          {raci.map((row) => (
                            <tr class={row.highlight ? "is-hl" : undefined}>
                              <th scope="row">{row.decision}</th>
                              {row.cells.map((c) => <td class={c.includes("A") ? "is-a" : undefined}>{c || <span class="sr-only">none</span>}</td>)}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    <p class="gp-callout">{raciNote}</p>
                  </>
                )}
                {a.id === "art-rag" && (
                  <>
                    <p class="gp-small gp-muted">No watermelon statuses: a watermelon is green on the outside and red on the inside. These criteria make status a measurement, not a mood. {tierNote}</p>
                    <div class="gp-scroll" tabindex="0" role="region" aria-label="Stoplight status criteria, scrolls horizontally">
                      <table class="gp-table gp-rag">
                        <thead><tr><th scope="col"><span class="sr-only">Dimension</span></th><th scope="col"><span class="gp-dot gp-g"></span>Green</th><th scope="col"><span class="gp-dot gp-a"></span>Yellow</th><th scope="col"><span class="gp-dot gp-r"></span>Red</th></tr></thead>
                        <tbody>
                          {ragRows.map((r) => <tr><th scope="row">{r.dim}</th><td>{r.g}</td><td>{r.a}</td><td>{r.r}</td></tr>)}
                          <tr class="gp-rag-meaning"><th scope="row">What it means</th><td>{ragMeaning.g}</td><td>{ragMeaning.a}</td><td>{ragMeaning.r}</td></tr>
                        </tbody>
                      </table>
                    </div>
                    <ol class="gp-rules">{ragRules.map((r) => <li>{r}</li>)}</ol>
                  </>
                )}
                {a.id === "art-raid" && (
                  <>
                    <p class="gp-small gp-muted">As of Day 52. One log for every program: risks, assumptions, issues and dependencies.</p>
                    <div class="gp-scroll" tabindex="0" role="region" aria-label="RAID log excerpt, scrolls horizontally">
                      <table class="gp-table gp-raid">
                        <thead><tr><th scope="col">ID</th><th scope="col">Type</th><th scope="col">Program</th><th scope="col">Description</th><th scope="col">Owner</th><th scope="col">Impact</th><th scope="col">Status</th><th scope="col">Next action</th></tr></thead>
                        <tbody>
                          {raid.map((r) => (
                            <tr class={r.key ? "is-hl" : undefined}>
                              <th scope="row" class="gp-mono">{r.id}</th><td>{r.type}</td><td>{r.prog}</td><td>{r.text}</td><td>{r.owner}</td><td>{r.impact}</td>
                              <td><span class={`gp-dot gp-${r.rag}`}></span>{ragLabel[r.rag]}</td><td>{r.next}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    <p class="gp-callout">{raidNote}</p>
                  </>
                )}
                {a.id === "art-preread" && (
                  <div class="gp-preread">
                    <p class="gp-ask"><span>Decision requested · Steering 2, Day 60</span>{steering.decision}</p>
                    <h4 class="gp-h5">Situation</h4>
                    <ul class="gp-list">{steering.situation.map((s) => <li>{s}</li>)}</ul>
                    <h4 class="gp-h5 gp-mt">Options</h4>
                    <div class="gp-scroll" tabindex="0" role="region" aria-label="Options, scrolls horizontally">
                      <table class="gp-table gp-pre-table">
                        <thead><tr><th scope="col"></th>{steering.options.map((o) => <th scope="col">{o.n}. {o.name}{o.recommended && " (recommended)"}</th>)}</tr></thead>
                        <tbody>
                          <tr><th scope="row">What happens</th>{steering.options.map((o) => <td>{o.short}</td>)}</tr>
                          <tr><th scope="row">Hours</th>{steering.options.map((o) => <td>{o.hours}</td>)}</tr>
                          <tr><th scope="row">Schedule</th>{steering.options.map((o) => <td>{o.schedule}</td>)}</tr>
                          <tr><th scope="row">Cost</th>{steering.options.map((o) => <td>{o.cost}</td>)}</tr>
                          <tr><th scope="row">Risk</th>{steering.options.map((o) => <td>{o.risk}</td>)}</tr>
                          <tr><th scope="row">Reversible?</th>{steering.options.map((o) => <td>{o.reversible}</td>)}</tr>
                        </tbody>
                      </table>
                    </div>
                    <h4 class="gp-h5 gp-mt">Recommendation</h4>
                    <p>{steering.recommendation}</p>
                    <h4 class="gp-h5 gp-mt">What we need from you</h4>
                    <ul class="gp-asks">{steering.asks.map((x) => <li><strong>{x.who}:</strong> {x.ask}</li>)}</ul>
                    <p class="gp-small gp-muted"><strong>If we don't decide on Day 60:</strong> {steering.noDecision}</p>
                  </div>
                )}
                {a.id === "art-exec" && <p><a href="#art-exec-full" class="gp-link">Shown in full in "What success looks like at Day 90" <span aria-hidden="true">↑</span></a></p>}
                {a.id === "art-log" && (
                  <>
                    <div class="gp-scroll" tabindex="0" role="region" aria-label="Decision log, scrolls horizontally">
                      <table class="gp-table gp-log">
                        <thead><tr><th scope="col">#</th><th scope="col">Day</th><th scope="col">Forum</th><th scope="col">Decision</th><th scope="col">Decided by</th><th scope="col">Basis</th><th scope="col">Revisit if</th></tr></thead>
                        <tbody>
                          {decisions.map((d) => (
                            <tr class={d.key ? "is-hl" : undefined}>
                              <th scope="row" class="gp-mono">{d.n}</th><td>{d.day}</td><td>{d.forum}</td><td>{d.decision}</td><td>{d.by}</td><td>{d.basis}</td><td>{d.revisit}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    <p class="gp-callout">The "Revisit if" column is the point: a decision should change when the evidence changes, and everyone should know in advance what evidence that is.</p>
                  </>
                )}
                {a.id === "art-inventory" && (
                  <div class="gp-scroll" tabindex="0" role="region" aria-label="Portfolio inventory">
                    <table class="gp-table">
                      <thead><tr><th scope="col">Program</th><th scope="col">Sponsor</th><th scope="col">Stage</th><th scope="col">Tier</th><th scope="col">Budget</th><th scope="col">Status</th></tr></thead>
                      <tbody>{programs.map((p) => <tr><th scope="row">{p.key}. {p.name}</th><td>{p.sponsor}</td><td>{p.stage}</td><td>{p.tier}</td><td>{p.budget}</td><td><span class={`gp-dot gp-${p.rag}`}></span>{ragLabel[p.rag]}</td></tr>)}</tbody>
                    </table>
                  </div>
                )}
                {a.id === "art-forums" && (
                  <ol class="gp-forums">
                    {forums.map((f) => <li><strong>{f.name}</strong> <span class="gp-muted">· {f.cadence}</span><br />Decides: {f.decides}<br /><span class="gp-muted gp-small">Who: {f.members}</span></li>)}
                  </ol>
                )}
                {a.id === "art-thresholds" && (
                  <>
                    <p class="gp-small gp-muted">{tierNote}</p>
                    <div class="gp-scroll" tabindex="0" role="region" aria-label="Escalation thresholds">
                      <table class="gp-table">
                        <thead><tr><th scope="col">Trigger</th><th scope="col">Threshold</th><th scope="col">Goes to</th><th scope="col">Within</th></tr></thead>
                        <tbody>{thresholds.map((t) => <tr><th scope="row">{t.trigger}</th><td>{t.limit}</td><td>{t.to}</td><td>{t.within}</td></tr>)}</tbody>
                      </table>
                    </div>
                    <h4 class="gp-h5 gp-mt">Where an issue gets decided</h4>
                    <ol class="gp-ladder">{routing.map((r) => <li><strong>{r.level}</strong><span>{r.decides}</span></li>)}</ol>
                  </>
                )}
                {a.id === "art-status" && (
                  <div class="gp-status">
                    <p class="gp-status-h"><span class={`gp-dot gp-${weeklyStatus.overall}`}></span><strong>{weeklyStatus.program}</strong> <span class="gp-muted">· {weeklyStatus.asOf} · Overall {ragLabel[weeklyStatus.overall]}</span></p>
                    <ul class="gp-status-dims">{weeklyStatus.dims.map((d) => <li><span class={`gp-dot gp-${d.rag}`}></span><strong>{d.dim}</strong> <span class="sr-only">({ragLabel[d.rag]})</span>{d.note}</li>)}</ul>
                    <p class="gp-small"><strong>Recovery:</strong> {weeklyStatus.recovery}</p>
                    <p class="gp-small"><strong>Done this week:</strong> {weeklyStatus.done}</p>
                    <p class="gp-small"><strong>Next week:</strong> {weeklyStatus.next}</p>
                    <p class="gp-small"><strong>Decisions needed:</strong> {weeklyStatus.needs}</p>
                  </div>
                )}
                {a.id === "art-scorecard" && (
                  <div class="gp-scoregrid">
                    {scorecard.map((g) => <div><h4 class="gp-h5">{g.group}</h4><dl>{g.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl></div>)}
                    <p class="gp-small gp-muted gp-span">Three groups, never rolled into one score. Shipping is not success; usage is.</p>
                  </div>
                )}
                {a.id === "art-readiness" && (
                  <div>
                    <p class="gp-small gp-muted">{readiness.program} · {readiness.asOf}</p>
                    <ul class="gp-ready">{readiness.items.map((it) => <li class={it.done ? "is-done" : "is-open"}><span aria-hidden="true">{it.done ? "✓" : "○"}</span><span>{it.item}{it.note && <span class="gp-muted"> ({it.note})</span>}<span class="sr-only">{it.done ? " (done)" : " (open)"}</span></span></li>)}</ul>
                  </div>
                )}
                <p class="gp-card-roles gp-small gp-muted">Received by: {a.roles.length === roles.length ? "every role" : a.roles.map((r) => roleNames[r]).join(", ")}</p>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>

    <!-- ══ DOCUMENTS ══ -->
    <section class="gp-close" id="documents" aria-labelledby="docs-title">
      <div class="gp-downloads gp-reveal">
        <h2 id="docs-title" class="gp-imo-h">Take it with you</h2>
        {documents.map((d) => (
          <article class="gp-doc">
            <a href={fileHref(d.file)} target="_blank" rel="noopener" class="gp-doc-thumb" tabindex="-1" aria-hidden="true"
              data-gp-view={fileHref(d.file)} data-gp-view-title={d.title}>
              <img src={fileHref(d.preview)} alt="" width="480" height="621" loading="lazy" decoding="async" />
            </a>
            <div class="gp-doc-body">
              <h3 class="gp-doc-title">{d.title}</h3>
              <p class="gp-doc-meta">{d.meta}</p>
              <p class="gp-doc-text">{d.text}</p>
              <p class="gp-doc-actions">
                <a href={fileHref(d.file)} target="_blank" rel="noopener" class="gp-btn gp-btn-sm"
                  data-gp-view={fileHref(d.file)} data-gp-view-title={d.title}
                  data-ga-event="playbook_document_open" data-ga-playbook={slug} data-ga-file={d.key}>Read<span class="sr-only"> {d.title} (PDF)</span></a>
                <a href={fileHref(d.file)} download class="gp-link gp-small"
                  data-ga-event="playbook_download" data-ga-playbook={slug} data-ga-file={d.key}>Download<span class="sr-only"> {d.title}</span></a>
              </p>
            </div>
          </article>
        ))}
      </div>
      <aside class="gp-author gp-reveal" aria-label="About the author">
        <p class="gp-author-name">Reginal Campbell, PMP</p>
        <p class="gp-muted gp-small">Enterprise transformation leader · U.S. Army veteran</p>
        <p class="gp-author-links">
          <a href="/record" data-ga-event="playbook_contact_click" data-ga-target="record">Professional record</a>
          <a href={evidence.href} data-ga-event="playbook_contact_click" data-ga-target="case-study">Case study</a>
          <a href={contactHref("role")} data-ga-event="playbook_contact_click" data-ga-target="contact">Get in touch</a>
        </p>
      </aside>
    </section>

    <aside class="gp-disclaimer" aria-label="Disclosure">
      <p><strong>About this page.</strong> {disclosure}</p>
      <p class="gp-small gp-muted">Prepared by Reginal Campbell, PMP · {meta.date}</p>
    </aside>

    <dialog class="gp-viewer" data-gp-viewer aria-labelledby="gp-viewer-title">
      <div class="gp-viewer-bar">
        <p id="gp-viewer-title" class="gp-viewer-title" data-gp-viewer-title>Document</p>
        <a href={fileHref(documents[0].file)} download class="gp-link gp-small" data-gp-viewer-download>Download</a>
        <a href={fileHref(documents[0].file)} target="_blank" rel="noopener" class="gp-link gp-small" data-gp-viewer-newtab>Open in new tab</a>
        <button type="button" class="gp-btn gp-btn-sm gp-btn-ghost" data-gp-viewer-close>Close<span class="sr-only"> document viewer</span></button>
      </div>
      <div class="gp-viewer-frame" data-gp-viewer-frame></div>
    </dialog>
  </div>
</PageLayout>

<script>
  import "../../../scripts/governance-playbook";
</script>
