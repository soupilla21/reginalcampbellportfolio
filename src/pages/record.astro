---
// Career section. Facts come from the site (homepage case study, /portfolio
// Foundation) and Reggie's resume (Reginal-Campbell-Resume-TechnicalProgramDelivery,
// supplied 30 Oct 2026). The 2024 to 2026 title follows the site, per Reggie.
import PageLayout from "../layouts/PageLayout.astro";
import { RESUME_URL, contactHref } from "../config/site";

const record = [
  {
    org: "Accenture Federal Services",
    years: "2024 to 2026",
    title: "Product Manager and Technical Program Lead, National Healthcare Data Exchange",
    body: "Client-facing delivery lead for a national healthcare data exchange platform processing 2B+ transactions a month. Standardized data definitions and governance raised user satisfaction by 30% while the platform sustained roughly 7% month-over-month expansion.",
    link: { label: "Read the case study", href: "/case-studies/national-healthcare-data-exchange" },
  },
  {
    org: "Cognosante (acquired by Accenture Federal Services)",
    years: "2022 to 2024",
    title: "Enterprise Program Manager, PMO: Data Integration and Analytics Platform",
    body: "Led portfolio delivery for cloud-based data integration, governance and analytics platforms. Directed cross-functional programs with 20+ team members across integration pipelines, FHIR/HL7 data flows and analytics enablement.",
  },
  {
    org: "Department of Veterans Affairs",
    years: "2018 to 2022",
    title: "Batch Automation Leader and Technical Program Lead",
    body: "Designed and delivered automated data workflows processing 1M+ veteran healthcare records a month, cutting operational costs 20%. Directed scope, sequencing, risk management and delivery for the platform.",
  },
  {
    org: "Department of Veterans Affairs",
    years: "2015 to 2018",
    title: "Systems Implementation Leader",
    body: "Led delivery of a $40M, multi-year enterprise platform, coordinating 25+ team members, vendors and executive stakeholders to a 95% program success rate.",
  },
  {
    org: "Department of Veterans Affairs",
    years: "2014 to 2015",
    title: "Management Analyst",
    body: "Managed a legacy data system ingesting 3M+ veteran records a month, with data quality standards and operational controls to reduce production risk.",
  },
];
const credentials = [
  "PMP, Project Management Institute",
  "M.S., Management Information Systems, University of Illinois Chicago",
  "B.S., Information Technology, Illinois Institute of Technology",
  "U.S. Army veteran, Staff Sergeant",
];
const sectors = ["Financial services", "Healthcare IT", "AI governance", "Enterprise program management"];
---
<PageLayout
  title="Leadership Record | Reginal Campbell"
  description="15+ years leading federal and enterprise data platforms. Targeting Director, Executive Director and VP roles in financial services, healthcare IT, AI governance and enterprise program management."
  path="/record"
  active="record"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://reginalcampbell.com/#person",
    "name": "Reginal Campbell",
    "url": "https://reginalcampbell.com/",
    "jobTitle": "Enterprise Transformation & AI Governance Leader",
    "description": "PMP-certified enterprise transformation and AI governance leader with 15+ years leading federal and enterprise data platforms.",
    "sameAs": [
      "https://www.linkedin.com/in/reginal-campbell-pmp-1551845/",
      "https://github.com/soupilla21"
    ],
    "mainEntityOfPage": "https://reginalcampbell.com/record"
  }}
>
  <header class="mb-14">
    <span class="text-amber-400 font-mono text-sm uppercase tracking-wider">Leadership record</span>
    <h1 class="text-3xl md:text-4xl font-bold mt-2">Reginal Campbell, PMP</h1>
    <p class="text-neutral-300 max-w-2xl mt-4 leading-relaxed">15+ years leading federal and enterprise data platforms, including a national healthcare data exchange processing 2B+ transactions a month.</p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href={contactHref("role")} data-ga-event="engage_contact_click" data-ga-source="record" class="btn-primary px-6 py-3 rounded-full bg-amber-400 text-black font-bold hover:bg-amber-300 transition inline-flex items-center gap-2">Contact me about a role <i aria-hidden="true" class="fas fa-arrow-right text-sm"></i></a>
      <a href={RESUME_URL} target="_blank" rel="noopener" data-resume-link data-ga-event="resume_download" data-ga-source="record_header" class="btn-secondary px-6 py-3 rounded-full border border-white/20 text-white font-medium hover:bg-white/5 transition inline-flex items-center gap-2">Download resume (PDF) <i aria-hidden="true" class="fas fa-file-pdf text-sm"></i></a>
    </div>
  </header>

  <section class="reveal" style="margin-bottom:4rem">
    <h2 class="text-xs font-mono text-amber-400 uppercase tracking-widest mb-5">Roles I'm targeting</h2>
    <div class="bg-neutral-900/40 rounded-2xl border border-white/10 p-6">
      <p class="text-white font-semibold text-lg">Director, Executive Director and VP roles</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {sectors.map((s) => <li class="px-3 py-1.5 rounded-full border border-amber-500/30 text-amber-200 text-sm">{s}</li>)}
      </ul>
    </div>
  </section>

  <section class="reveal" style="margin-bottom:4rem">
    <h2 class="text-xs font-mono text-amber-400 uppercase tracking-widest mb-5">Record</h2>
    <ol class="flex flex-col gap-5">
      {record.map((r) => (
        <li class="bg-neutral-900/40 rounded-2xl border border-white/5 p-6 grid md:grid-cols-[180px_1fr] gap-2 md:gap-8">
          <div>
            <p class="font-mono text-sm text-amber-400">{r.years}</p>
            <p class="text-neutral-400 text-sm mt-1">{r.org}</p>
          </div>
          <div>
            <h3 class="text-white font-semibold">{r.title}</h3>
            <p class="text-neutral-300 text-sm leading-relaxed mt-2">{r.body}</p>
            {r.link && <a href={r.link.href} class="mt-3 inline-flex items-center gap-1.5 text-sm font-mono text-amber-300 hover:text-amber-200">{r.link.label} <i aria-hidden="true" class="fas fa-arrow-right text-[10px]"></i></a>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="reveal" style="margin-bottom:3rem">
    <h2 class="text-xs font-mono text-amber-400 uppercase tracking-widest mb-5">Credentials</h2>
    <ul class="grid md:grid-cols-2 gap-3">
      {credentials.map((c) => <li class="text-neutral-300 text-sm flex gap-3"><span class="text-amber-400" aria-hidden="true">→</span>{c}</li>)}
    </ul>
    <p class="text-neutral-400 text-sm mt-6">Delivery artifacts, governance approach and the architecture lab are on the <a href="/portfolio" class="text-amber-300 underline underline-offset-4">portfolio page</a>. Supporting evidence is on the <a href="/evidence" class="text-amber-300 underline underline-offset-4">evidence page</a>.</p>
  </section>

  <div class="mt-12 border-t border-white/10 pt-8 flex flex-wrap gap-4">
    <a href={contactHref("role")} data-ga-event="engage_contact_click" data-ga-source="record" class="btn-primary px-6 py-3 rounded-full bg-amber-400 text-black font-bold hover:bg-amber-300 transition inline-flex items-center gap-2">Contact me about a role <i aria-hidden="true" class="fas fa-arrow-right text-sm"></i></a>
    <a href={RESUME_URL} target="_blank" rel="noopener" data-resume-link data-ga-event="resume_download" data-ga-source="record_footer" class="btn-secondary px-6 py-3 rounded-full border border-white/20 text-white font-medium hover:bg-white/5 transition inline-flex items-center gap-2">Download resume (PDF)</a>
  </div>
</PageLayout>
