---
import PageLayout from "../layouts/PageLayout.astro";
import OfferBits from "../components/OfferBits.astro";
import { contactHref } from "../config/site";

const formats = [
  {
    name: "AI governance and delivery assessment",
    body: "A fixed-scope review of one AI or data program: its governance, data foundation, delivery cadence and decision structure.",
    get: "A written findings report tied to evidence, and an action plan in priority order with an owner for each item.",
  },
  {
    name: "Program recovery",
    body: "For a program that has slipped on scope, schedule or trust. I establish what is true about scope, risk and dependencies, reset the operating cadence, and put decisions back in front of the people who own them.",
    get: "A recovery plan, a working RAID log and decision log, and a reporting cadence your leadership can rely on.",
  },
  {
    name: "Fractional delivery lead",
    body: "I lead delivery inside your organization on a part-time basis: integrated planning, risk and dependency management, steering committee materials, executive reporting and vendor accountability.",
    get: "A delivery leader in the room each week, and an operating cadence your team keeps running after the engagement ends.",
  },
];
---
<PageLayout
  title="Enterprise Advisory | Reginal Campbell"
  description="AI governance and delivery discipline for regulated organizations: assessments, program recovery and fractional delivery leadership."
  path="/advisory"
  active="engage"
  event={{ name: "offer_view", params: { offer: "advisory" } }}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "InnovatePM Solutions",
    "url": "https://reginalcampbell.com/advisory",
    "description": "AI governance and delivery discipline for regulated organizations: assessments, program recovery and fractional delivery leadership.",
    "serviceType": "Enterprise AI governance and delivery advisory",
    "founder": { "@id": "https://reginalcampbell.com/#person" }
  }}
>
  <header class="mb-14">
    <span class="text-amber-400 font-mono text-sm uppercase tracking-wider">Enterprise advisory</span>
    <h1 class="text-3xl md:text-4xl font-bold mt-2">AI governance and delivery discipline for regulated organizations.</h1>
    <p class="text-neutral-300 max-w-2xl mt-4 leading-relaxed">I turn complex AI and data programs into accountable execution. I do this as an advisor to your leadership or as a delivery leader inside your program.</p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href={contactHref("advisory")} data-ga-event="engage_contact_click" data-ga-source="advisory" class="btn-primary px-6 py-3 rounded-full bg-amber-400 text-black font-bold hover:bg-amber-300 transition inline-flex items-center gap-2">Discuss an engagement <i aria-hidden="true" class="fas fa-arrow-right text-sm"></i></a>
      <a href="/case-studies/national-healthcare-data-exchange" class="btn-secondary px-6 py-3 rounded-full border border-white/20 text-white font-medium hover:bg-white/5 transition inline-flex items-center gap-2">Read the case study</a>
    </div>
  </header>

  <section class="reveal" style="margin-bottom:4rem">
    <h2 class="text-xs font-mono text-amber-400 uppercase tracking-widest mb-5">Who it's for</h2>
    <ul class="grid md:grid-cols-3 gap-5">
      <li class="bg-neutral-900/40 rounded-2xl border border-white/5 p-6 text-neutral-300 text-sm leading-relaxed">Healthcare, federal and financial services organizations running AI or data programs under regulatory scrutiny.</li>
      <li class="bg-neutral-900/40 rounded-2xl border border-white/5 p-6 text-neutral-300 text-sm leading-relaxed">Executives who own an AI or data program that has slipped on scope, schedule or trust.</li>
      <li class="bg-neutral-900/40 rounded-2xl border border-white/5 p-6 text-neutral-300 text-sm leading-relaxed">Program and technology leaders who need governance that holds up under audit, not only on paper.</li>
    </ul>
  </section>

  <section class="reveal" style="margin-bottom:4rem">
    <h2 class="text-xs font-mono text-amber-400 uppercase tracking-widest mb-5">Problems I solve</h2>
    <ul class="flex flex-col gap-3 text-neutral-300 leading-relaxed max-w-3xl">
      <li class="flex gap-3"><span class="text-amber-400" aria-hidden="true">→</span>AI and data initiatives that are not delivering the outcomes they were funded for.</li>
      <li class="flex gap-3"><span class="text-amber-400" aria-hidden="true">→</span>Decisions that stall because no one owns them, or get made without the data to back them.</li>
      <li class="flex gap-3"><span class="text-amber-400" aria-hidden="true">→</span>Governance that exists as documents but does not hold when an auditor or a regulator tests it.</li>
      <li class="flex gap-3"><span class="text-amber-400" aria-hidden="true">→</span>Models built on data no one can vouch for. Model validation depends on data you trust.</li>
      <li class="flex gap-3"><span class="text-amber-400" aria-hidden="true">→</span>Architecture and platform choices that need an independent review before the money is spent.</li>
    </ul>
  </section>

  <section class="reveal" style="margin-bottom:4rem">
    <h2 class="text-xs font-mono text-amber-400 uppercase tracking-widest mb-5">Engagement formats</h2>
    <div class="grid md:grid-cols-3 gap-5">
      {formats.map((f, i) => (
        <div class="bg-neutral-900/40 rounded-2xl border border-white/10 p-6 flex flex-col gap-3">
          <span class="w-6 h-6 rounded-full bg-amber-500/20 text-amber-400 font-mono text-xs flex items-center justify-center font-bold">{i + 1}</span>
          <h3 class="text-lg font-bold text-white">{f.name}</h3>
          <p class="text-neutral-300 text-sm leading-relaxed">{f.body}</p>
          <p class="text-neutral-400 text-sm leading-relaxed mt-auto pt-3 border-t border-white/5"><strong class="text-neutral-200">You receive:</strong> {f.get}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="reveal" style="margin-bottom:4rem">
    <div class="bg-black/50 border border-amber-500/25 border-l-4 border-l-amber-500 rounded-2xl p-6 md:p-8">
      <p class="text-amber-400 font-mono text-xs uppercase tracking-widest mb-3">Why this works</p>
      <p class="text-neutral-100 leading-relaxed">Most AI advisors know models. Fewer have run delivery where governance was not optional, where an ungoverned data layer has consequences measured in delayed veteran care, compliance findings and failed federal audits. I have built AI systems, and I have led delivery on national healthcare data platforms. You get both in one engagement: governance designed as a working part of the program, not a compliance task added at the end.</p>
    </div>
  </section>

  <section class="reveal" style="margin-bottom:4rem">
    <h2 class="text-xs font-mono text-amber-400 uppercase tracking-widest mb-5">The record behind it</h2>
    <div class="grid md:grid-cols-3 gap-5">
      <div class="bg-neutral-900/40 rounded-2xl border border-white/5 p-6 flex flex-col gap-1">
        <span class="font-mono text-3xl font-bold text-white">2B+</span>
        <span class="text-neutral-400 text-sm">Monthly transactions on the national healthcare data exchange where I was client-facing delivery lead (Accenture Federal Services)</span>
      </div>
      <div class="bg-neutral-900/40 rounded-2xl border border-white/5 p-6 flex flex-col gap-1">
        <span class="font-mono text-3xl font-bold text-white">$40M</span>
        <span class="text-neutral-400 text-sm">Multi-year VA enterprise platform</span>
      </div>
      <div class="bg-neutral-900/40 rounded-2xl border border-white/5 p-6 flex flex-col gap-1">
        <span class="font-mono text-3xl font-bold text-white">1M+</span>
        <span class="text-neutral-400 text-sm">Veteran records on the VA data platform I directed</span>
      </div>
    </div>
    <a href="/case-studies/national-healthcare-data-exchange" class="mt-6 inline-flex items-center gap-1.5 text-sm font-mono text-amber-300 hover:text-amber-200">Read the National Healthcare Data Exchange case study <i aria-hidden="true" class="fas fa-arrow-right text-[10px]"></i></a>
  </section>

  <section class="reveal" style="margin-bottom:3rem">
    <h2 class="text-xs font-mono text-amber-400 uppercase tracking-widest mb-5">How to start</h2>
    <ol class="grid md:grid-cols-3 gap-5">
      <li class="text-neutral-300 text-sm leading-relaxed"><span class="block font-mono text-amber-400 mb-2">01</span>Send an inquiry with a few lines on the program and what is not working.</li>
      <li class="text-neutral-300 text-sm leading-relaxed"><span class="block font-mono text-amber-400 mb-2">02</span>We talk through the problem and decide whether one of these formats fits.</li>
      <li class="text-neutral-300 text-sm leading-relaxed"><span class="block font-mono text-amber-400 mb-2">03</span>You receive a written proposal with scope, deliverables and price.</li>
    </ol>
  </section>

  <div class="grid md:grid-cols-2 gap-5">
    <OfferBits kind="pricing" />
    <OfferBits kind="firm" />
  </div>

  <div class="mt-12 border-t border-white/10 pt-8 flex flex-wrap gap-4">
    <a href={contactHref("advisory")} data-ga-event="engage_contact_click" data-ga-source="advisory" class="btn-primary px-6 py-3 rounded-full bg-amber-400 text-black font-bold hover:bg-amber-300 transition inline-flex items-center gap-2">Discuss an engagement <i aria-hidden="true" class="fas fa-arrow-right text-sm"></i></a>
    <a href="/engage" class="btn-secondary px-6 py-3 rounded-full border border-white/20 text-white font-medium hover:bg-white/5 transition inline-flex items-center gap-2">All ways to work together</a>
  </div>
</PageLayout>
