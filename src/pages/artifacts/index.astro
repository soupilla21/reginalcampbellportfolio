---
import "../../styles/global.css";
import { getCollection } from "astro:content";

// Sort: entries with an explicit `order` ascending first, then entries without
// an `order` alphabetically by title. `order` is optional in the schema, so the
// undefined case is a real path, not a theoretical one.
const artifacts = (await getCollection("artifacts", ({ data }) => !data.draft)).sort((a, b) => {
  const ao = a.data.order;
  const bo = b.data.order;
  if (ao !== undefined && bo !== undefined) return ao - bo;
  if (ao !== undefined) return -1;
  if (bo !== undefined) return 1;
  return a.data.title.localeCompare(b.data.title);
});

const title = "Governance Artifacts — Reginal Campbell";
const description = "Worked examples of applied AI governance: risk assessment, policy, and compliance practice with the reasoning left visible.";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-32FSF2EFEW"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-32FSF2EFEW');
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Reginal Campbell">
  <meta name="robots" content="index, follow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body class="antialiased">
  <a href="#artifacts-main" class="skip-link">Skip to main content</a>

  <nav id="main-nav" aria-label="Main navigation">
    <div class="inner">
      <div class="flex items-center gap-2 min-w-0">
        <a href="/" class="text-lg font-bold tracking-tight bg-gradient-to-r from-white to-gray-400 bg-clip-text text-transparent whitespace-nowrap">REGINAL CAMPBELL</a>
        <span class="hidden md:inline text-neutral-500 font-mono text-sm">|</span>
        <span class="hidden md:inline text-sm font-mono text-neutral-400 truncate">AI &amp; Data Strategy</span>
      </div>
      <div class="flex items-center gap-5 text-sm font-medium flex-shrink-0">
        <a href="/#case-study" class="nav-link">Work</a>
        <a href="/#delivery-portfolio" class="nav-link">Portfolio</a>
        <a href="/#governance" class="nav-link nav-active">Governance</a>
        <a href="/#innovation-lab" class="nav-link">Lab</a>
        <a href="/#point-of-view" class="nav-link">POV</a>
        <a href="/articles" class="nav-link">Articles</a>
        <a href="/#contact" class="nav-link">Contact</a>
        <a href="https://briefing.reginalcampbell.com" class="nav-link">Ask the AI</a>
      </div>
    </div>
  </nav>

  <main id="artifacts-main" style="max-width:860px;margin:0 auto;padding:calc(var(--nav-height, 64px) + 48px) 24px 96px;">
    <header class="mb-12">
      <span class="text-amber-400 font-mono text-sm uppercase tracking-wider">Governance Artifacts</span>
      <h1 class="text-3xl md:text-4xl font-bold mt-2">Applied AI Governance, With the Reasoning Shown.</h1>
      <p class="text-neutral-400 max-w-3xl mt-4 leading-relaxed">
        Worked examples rather than blank templates. Each artifact is filled in against a
        named system, with the scoring rationale, the rejected alternatives, and the accepted
        residual risk left visible. Read in order; each builds on the one before it.
      </p>
    </header>

    {artifacts.length === 0 ? (
      <p class="text-neutral-400">No artifacts published yet — check back soon.</p>
    ) : (
      <ul class="space-y-6">
        {artifacts.map((artifact) => (
          <li class="bg-neutral-900/40 rounded-2xl border border-white/8 p-6">
            <a href={`/artifacts/${artifact.id}`} class="block hover:opacity-90 transition">
              <span class="text-neutral-500 text-xs font-mono uppercase tracking-widest">
                Last reviewed {artifact.data.lastReviewed.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })} · v{artifact.data.version}
              </span>
              <h2 class="text-xl font-bold mt-2">{artifact.data.title}</h2>
              <p class="text-neutral-400 text-sm mt-2 leading-relaxed">{artifact.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</body>
</html>
