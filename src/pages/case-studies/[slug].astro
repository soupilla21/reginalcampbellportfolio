---
import PageLayout from "../../layouts/PageLayout.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import { caseStudies } from "../../data/case-studies";

// Drafts build on Vercel previews and locally for review, never on production.
export function getStaticPaths() {
  const isProduction = process.env.VERCEL_ENV === "production";
  return caseStudies
    .filter((study) => study.status === "published" || !isProduction)
    .map((study) => ({ params: { slug: study.slug }, props: { study } }));
}
const { study } = Astro.props;
---
<PageLayout
  title={`${study.title} Case Study | Reginal Campbell`}
  description={study.summary}
  path={`/case-studies/${study.slug}`}
  active="record"
  noindex={study.status !== "published"}
  event={{
    name: "case_study_view",
    params: {
      case_study_name: study.title,
      interaction_type: "page_view",
      content_area: "case_study_page",
    },
  }}
>
  <CaseStudy study={study} />
</PageLayout>
