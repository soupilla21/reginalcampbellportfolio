 const key = el.getAttribute("data-saas-agent");
 const data = saasAgentData[key];
 if (!data) return;
 document.querySelectorAll("[data-saas-agent]").forEach(n => { n.style.boxShadow = ""; n.style.transform = ""; });
 el.style.boxShadow = "0 0 0 2px rgba(20,184,166,0.8)";
 el.style.transform = "scale(1.05)";
 document.getElementById("saas-agent-stage").textContent = data.stage;
 document.getElementById("saas-agent-name").textContent = data.name;
 document.getElementById("saas-agent-detail").textContent = data.detail;
 document.getElementById("saas-agent-input").textContent = data.input;
 document.getElementById("saas-agent-output").textContent = data.output;
 const card = document.getElementById("saas-agent-detail-card");
 card.style.display = "block";
 setTimeout(() => card.scrollIntoView({ behavior: "smooth", block: "nearest" }), 50);
 }

 function closeSaasAgent() {
 document.getElementById("saas-agent-detail-card").style.display = "none";
 document.querySelectorAll("[data-saas-agent]").forEach(n => { n.style.boxShadow = ""; n.style.transform = ""; });
 }

 // Form handling
 const form = document.getElementById("contact-form");
 if (form) {
 form.addEventListener("submit", async function(e) {
 e.preventDefault();
 const btn = document.getElementById("form-submit-btn");
 const successEl = document.getElementById("form-success");
 const errorEl = document.getElementById("form-error");
 const honeypot = form.querySelector("input[name=_gotcha]");
 if (honeypot && honeypot.value) return;
 if (btn.disabled) return;

 const name = form.querySelector("input[name=name]").value.trim();
 const email = form.querySelector("input[name=email]").value.trim();
 const message = form.querySelector("textarea[name=message]").value.trim();
 const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

 if (!name || !email || !message) {
 errorEl.querySelector("p").textContent = "✗ Please fill in all required fields.";
 errorEl.classList.remove("hidden");
 return;
 }
 if (!emailRe.test(email)) {
 errorEl.querySelector("p").textContent = "✗ Please enter a valid email address.";
 errorEl.classList.remove("hidden");
 return;
 }

 successEl.classList.add("hidden");
 errorEl.classList.add("hidden");
 btn.innerHTML = 'Sending… <i aria-hidden="true" class="fas fa-spinner fa-spin text-sm"></i>';
 btn.disabled = true;
 btn.style.opacity = "0.7";

 try {
 const res = await fetch(form.action, {
 method: "POST",
 body: new FormData(form),
 headers: { "Accept": "application/json" }
 });
 if (res.ok) {
 form.reset();
 successEl.classList.remove("hidden");
 btn.innerHTML = "Sent ✓";
 if (resetButtonTimer) clearTimeout(resetButtonTimer);
 resetButtonTimer = setTimeout(() => {
 btn.innerHTML = 'Send Message <i aria-hidden="true" class="fas fa-paper-plane text-sm"></i>';
 btn.disabled = false;
 btn.style.opacity = "1";
 resetButtonTimer = null;
 }, 3000);
 } else {
 throw new Error("Server error");
 }
 } catch (err) {
 errorEl.querySelector("p").textContent = "✗ Submission failed.";
 errorEl.classList.remove("hidden");
 btn.innerHTML = 'Send Message <i aria-hidden="true" class="fas fa-paper-plane text-sm"></i>';
 btn.disabled = false;
 btn.style.opacity = "1";
 }
 });
 }

 // Innovation Lab sidebar: show/hide via body class when section is in view
 const labSection = document.getElementById('innovation-lab');
 if (labSection) {
   const labObserver = new IntersectionObserver((entries) => {
     entries.forEach(entry => {
       if (entry.isIntersecting) {
         document.body.classList.add('in-innovation-lab');
       } else {
         document.body.classList.remove('in-innovation-lab');
       }
     });
   }, { threshold: 0.05 });
   labObserver.observe(labSection);
 }

 // Force reveal any hidden sections after 2s
 setTimeout(() => {
 document.querySelectorAll('.reveal:not(.visible)').forEach(el => el.classList.add('visible'));
 }, 2000);

 // Initialize with edge panel open, unless the URL requests a different one
 // (e.g. a provenance chip linking to /#panel-saas from the Portfolio
 // Intelligence System). Falls back to edge for a bare page load, matching
 // the prior default exactly.
 const archHash = window.location.hash.slice(1);
 const archFromHash = ['panel-edge', 'panel-cloud', 'panel-saas'].includes(archHash)
   ? archHash.replace('panel-', '')
   : 'edge';
 setActiveArchitecture(archFromHash, archFromHash !== 'edge', false);

 // Add keyboard handlers for pipeline nodes
 document.querySelectorAll('.pipeline-node').forEach(node => {
 node.addEventListener('keydown', (e) => {
 if (e.key === 'Enter' || e.key === ' ') {
 e.preventDefault();
 node.click();
 }
 });
 });

 // ── SCROLL PROGRESS BAR ──
 const progressBar = document.getElementById('scroll-progress');
 if (progressBar) {
   const updateProgress = () => {
     const scrollTop = window.scrollY;
     const docHeight = document.documentElement.scrollHeight - window.innerHeight;
     const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
     progressBar.style.width = pct.toFixed(2) + '%';
   };
   window.addEventListener('scroll', updateProgress, { passive: true });
   updateProgress();
 }

 // ── PIPELINE NODE PULSE on architecture switch ──
 // Wrap the existing setActiveArchitecture to add pulse to the first node of the active panel
 const _origSetArch = typeof setActiveArchitecture === 'function' ? setActiveArchitecture : null;
 function applyPulseToActivePanel(archName) {
   // Remove pulse from all nodes first
   document.querySelectorAll('.pipeline-node.pulse-node').forEach(n => n.classList.remove('pulse-node'));
   // Find first pipeline node inside the newly active panel
   const panel = document.getElementById('panel-' + archName);
   if (panel) {
     const firstNode = panel.querySelector('.pipeline-node');
     if (firstNode) {
       firstNode.classList.add('pulse-node');
       // Remove pulse after 3 cycles (~4.2s) so it doesn't run forever
       setTimeout(() => firstNode.classList.remove('pulse-node'), 4200);
     }
   }
 }

 // Hook into arch toggle buttons
 document.querySelectorAll('.arch-toggle, .arch-toggle-mobile').forEach(btn => {
   btn.addEventListener('click', () => {
     const arch = btn.getAttribute('data-arch');
     if (arch) setTimeout(() => applyPulseToActivePanel(arch), 50);
   });
 });

 // Fire once on load for the default active arch
 setTimeout(() => applyPulseToActivePanel('edge'), 600);

 </script>

</body>
</html>
