 <button onclick="toggleCode('edge-code')" aria-expanded="false" aria-controls="edge-code" class="text-sm font-mono text-amber-400 border border-amber-500/30 px-4 py-2 rounded-lg hover:bg-amber-500/10 transition" id="edge-code-btn">
