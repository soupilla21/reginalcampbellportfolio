 // ── CASE STUDY VIEW TRACKING (GA4) ──
 // Fires a `view_case_study` event any time a visitor genuinely engages with one of
 // the case-study narratives, whether by scrolling to it, downloading its PDF, or
 // clicking into its interactive architecture panel. `case_study_name` is the
 // dimension to slice by in GA4 to see which story actually holds attention.
 const _firedCaseStudyEvents = new Set();
 function trackCaseStudyView(caseStudyName, interactionType, contentArea, extraParams) {
   if (typeof gtag !== 'function' || !caseStudyName) return;
   // De-dupe passive scroll views per section per pageview so re-scrolling past
   // a section doesn't spam events. Clicks/downloads are real actions each time
   // and are always sent.
   const dedupeKey = caseStudyName + '|' + interactionType + '|' + contentArea;
   if (interactionType === 'scroll_view') {
     if (_firedCaseStudyEvents.has(dedupeKey)) return;
     _firedCaseStudyEvents.add(dedupeKey);
   }
   gtag('event', 'view_case_study', Object.assign({
     case_study_name: caseStudyName,
     interaction_type: interactionType, // 'scroll_view' | 'click_download' | 'click_explore'
     content_area: contentArea          // e.g. 'case_study_section', 'delivery_portfolio_card', 'ai_systems_section', 'innovation_lab_panel'
   }, extraParams || {}));
 }

 function setActiveArchitecture(arch, scrollToPanel, isUserAction) {
 if (isUserAction === undefined) isUserAction = true;
 if (currentArch === arch) {
 document.getElementById('panel-' + arch).classList.remove('open');
 document.body.removeAttribute('data-arch');
 document.querySelectorAll('[aria-pressed]').forEach(b => b.setAttribute('aria-pressed', 'false'));
 document.querySelectorAll('[aria-expanded][data-arch-card]').forEach(c => c.setAttribute('aria-expanded', 'false'));
 currentArch = null;
 return;
 }

 ['edge','cloud','saas'].forEach(a => {
