 function toggleArticle(id) {
   const el = document.getElementById(id);
   const btn = document.getElementById(id + '-btn');
   if (!el || !btn) return;
   const isHidden = el.classList.contains('hidden');
   el.classList.toggle('hidden');
   btn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
   btn.innerHTML = isHidden
     ? btn.innerHTML.replace('↓', '↑').replace('Read Article', 'Close Article')
     : btn.innerHTML.replace('↑', '↓').replace('Close Article', 'Read Article');
   if (isHidden) {
     setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 50);
   }
 }

 // Auto-expand an article if the page loads with its id as the URL fragment
 // (e.g. a provenance chip linking to /#article2 from the Portfolio Intelligence
 // System). Without this, the fragment scrolls to the collapsed section but the
 // article text stays hidden until a visitor manually clicks "Read Article."
 document.addEventListener('DOMContentLoaded', () => {
   const hash = window.location.hash.slice(1);
   if (['article1', 'article2', 'article3'].includes(hash)) {
     toggleArticle(hash);
   }
 });

