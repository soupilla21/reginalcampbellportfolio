---
// Shared layout for the Week 2 content pages: case studies, offer pages,
// /engage and /record. Same head, nav, footer and scripts as /portfolio.
// Pages pass noindex while they still hold unconfirmed drafts.
import Analytics from "../components/Analytics.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteScripts from "../components/SiteScripts.astro";
import TrackClicks from "../components/TrackClicks.astro";
import { RESUME_URL } from "../config/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path: string;
  active?: string;
  noindex?: boolean;
  width?: number;
}
const { title, description, path, active = "", noindex = false, width = 960 } = Astro.props;
const url = `https://reginalcampbell.com${path}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <Analytics />
  <meta charset="UTF-8">
  <meta name="color-scheme" content="dark">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Reginal Campbell">
  <link rel="canonical" href={url}>
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={url}>
  <meta property="og:image" content="https://reginalcampbell.com/assets/reginal-campbell.jpg">
  <meta name="twitter:card" content="summary">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body class="antialiased">
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <div id="scroll-progress" aria-hidden="true"></div>
  <SiteNav active={active} />
  <button id="back-to-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="Back to top"
    style="display:none;position:fixed;bottom:100px;right:24px;z-index:49;width:44px;height:44px;border-radius:50%;background:rgba(245,158,11,0.14);border:1px solid rgba(245,158,11,0.35);color:#F59E0B;font-size:18px;cursor:pointer;align-items:center;justify-content:center;">
    <i aria-hidden="true" class="fas fa-arrow-up"></i>
  </button>
  <main id="main-content" style={`max-width:${width}px;margin:0 auto;padding:calc(var(--nav-height, 64px) + 48px) 24px 48px;`}>
    <slot />
    <footer class="mt-24 border-t border-white/10 pt-10 pb-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-neutral-400 text-center md:text-left">Reginal Campbell · Enterprise Transformation Leader · PMP · U.S. Army Veteran</p>
      <div class="flex flex-wrap justify-center gap-6">
        <a href={RESUME_URL} target="_blank" rel="noopener" data-resume-link class="text-sm text-white hover:text-amber-400 transition">Download Executive Resume</a>
        <a href="https://www.linkedin.com/in/reginal-campbell-pmp-1551845/" target="_blank" rel="noopener noreferrer" class="text-sm text-white hover:text-amber-400 transition">Connect on LinkedIn →</a>
      </div>
    </footer>
  </main>
  <SiteScripts />
  <TrackClicks />
</body>
</html>
