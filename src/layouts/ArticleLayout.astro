---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  ogImage: string;
  ogImageAlt: string;
  slug: string;
  canonical?: string;
  readingTime?: number;
}

const { title, description, pubDate, updatedDate, ogImage, ogImageAlt, slug, canonical, readingTime } = Astro.props;

const pageUrl = new URL(`/articles/${slug}`, Astro.site).toString();
const canonicalUrl = canonical ?? pageUrl;
const absoluteOgImage = new URL(ogImage, Astro.site).toString();
const pageTitle = `${title} — Reginal Campbell`;
const publishedISO = pubDate.toISOString();
const modifiedISO = (updatedDate ?? pubDate).toISOString();

const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  image: absoluteOgImage,
  datePublished: publishedISO,
  dateModified: modifiedISO,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": pageUrl,
  },
  author: {
    "@id": "https://reginalcampbell.com/#person",
  },
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-32FSF2EFEW"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-32FSF2EFEW');
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Reginal Campbell">
  <link rel="canonical" href={canonicalUrl}>
  <meta name="robots" content="index, follow">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="article">
  <meta property="og:url" content={pageUrl}>
  <meta property="og:image" content={absoluteOgImage}>
  <meta property="og:image:alt" content={ogImageAlt}>
  <meta property="article:published_time" content={publishedISO}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={absoluteOgImage}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPostingJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body class="antialiased">
  <a href="#article-main" class="skip-link">Skip to main content</a>

  <nav id="main-nav" aria-label="Main navigation">
    <div class="inner">
      <div class="flex items-center gap-2 min-w-0">
        <a href="/" class="text-lg font-bold tracking-tight bg-gradient-to-r from-white to-gray-400 bg-clip-text text-transparent whitespace-nowrap">REGINAL CAMPBELL</a>
        <span class="hidden md:inline text-neutral-500 font-mono text-sm">|</span>
        <span class="hidden md:inline text-sm font-mono text-neutral-400 truncate">AI &amp; Data Strategy</span>
      </div>
      <div class="flex items-center gap-5 text-sm font-medium flex-shrink-0">
        <a href="/#case-study" class="nav-link">Work</a>
        <a href="/#delivery-portfolio" class="nav-link">Portfolio</a>
        <a href="/#governance" class="nav-link">Governance</a>
        <a href="/#innovation-lab" class="nav-link">Lab</a>
        <a href="/#point-of-view" class="nav-link">POV</a>
        <a href="/articles" class="nav-link">Articles</a>
        <a href="/#contact" class="nav-link">Contact</a>
        <a href="https://briefing.reginalcampbell.com" class="nav-link">Ask the AI</a>
      </div>
    </div>
  </nav>

  <main id="article-main" style="max-width:760px;margin:0 auto;padding:calc(var(--nav-height, 64px) + 48px) 24px 96px;">
    <article id="article-content-body" data-slug={slug}>
      <header class="mb-10">
        <p class="text-neutral-500 text-xs font-mono uppercase tracking-widest">
          By Reginal Campbell · {pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}{readingTime ? ` · ${readingTime}-minute read` : ""}
        </p>
        <h1 class="text-3xl md:text-4xl font-bold mt-3">{title}</h1>
      </header>
      <div class="prose-article">
        <slot />
      </div>
    </article>
  </main>

  <script is:inline>
    (function () {
      var seen = new Set();
      var thresholds = [25, 50, 75, 100];
      var articleEl = document.getElementById("article-content-body");
      if (!articleEl) return;
      var slug = articleEl.getAttribute("data-slug");

      function checkDepth() {
        var scrollTop = window.scrollY || document.documentElement.scrollTop;
        var docHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (docHeight <= 0) return;
        var pct = (scrollTop / docHeight) * 100;
        thresholds.forEach(function (t) {
          if (pct >= t && !seen.has(t)) {
            seen.add(t);
            if (typeof gtag === "function") {
              gtag("event", "article_read_depth", {
                article_slug: slug,
                depth_percent: t,
              });
            }
          }
        });
      }

      window.addEventListener("scroll", checkDepth, { passive: true });
      checkDepth();
    })();
  </script>
</body>
</html>
