---
import Analytics from "../components/Analytics.astro";
import SiteNav from "../components/SiteNav.astro";
import RelatedReading from "../components/RelatedReading.astro";
import TrackClicks from "../components/TrackClicks.astro";
import type { CollectionEntry } from "astro:content";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  ogImage: string;
  ogImageAlt: string;
  slug: string;
  canonical?: string;
  readingTime?: number;
  related?: CollectionEntry<"articles">[];
}

const { title, description, pubDate, updatedDate, ogImage, ogImageAlt, slug, canonical, readingTime, related = [] } = Astro.props;

const pageUrl = new URL(`/articles/${slug}`, Astro.site).toString();
const canonicalUrl = canonical ?? pageUrl;
const absoluteOgImage = new URL(ogImage, Astro.site).toString();
const pageTitle = `${title} | Reginal Campbell`;
const publishedISO = pubDate.toISOString();
const modifiedISO = (updatedDate ?? pubDate).toISOString();

const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  image: absoluteOgImage,
  datePublished: publishedISO,
  dateModified: modifiedISO,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": pageUrl,
  },
  author: {
    "@id": "https://reginalcampbell.com/#person",
  },
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <Analytics />
  <meta charset="UTF-8">
  <meta name="color-scheme" content="dark">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Reginal Campbell">
  <link rel="canonical" href={canonicalUrl}>
  <meta name="robots" content="index, follow">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="article">
  <meta property="og:url" content={pageUrl}>
  <meta property="og:image" content={absoluteOgImage}>
  <meta property="og:image:alt" content={ogImageAlt}>
  <meta property="article:published_time" content={publishedISO}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={absoluteOgImage}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPostingJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body class="antialiased">
  <a href="#article-main" class="skip-link">Skip to main content</a>

  <SiteNav />

  <main id="article-main" style="max-width:760px;margin:0 auto;padding:calc(var(--nav-height, 64px) + 48px) 24px 96px;">
    <article id="article-content-body" data-slug={slug}>
      <header class="mb-10">
        <p class="text-neutral-500 text-xs font-mono uppercase tracking-widest">
          By Reginal Campbell · {pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}{readingTime ? ` · ${readingTime}-minute read` : ""}
        </p>
        <h1 class="text-3xl md:text-4xl font-bold mt-3">{title}</h1>
      </header>
      <div class="prose-article">
        <slot />
      </div>
    </article>
    <RelatedReading fromSlug={slug} articles={related} />
  </main>

  <script is:inline>
    (function () {
      var seen = new Set();
      var thresholds = [25, 50, 75, 100];
      var articleEl = document.getElementById("article-content-body");
      if (!articleEl) return;
      var slug = articleEl.getAttribute("data-slug");

      // Depth is measured to the end of the article (through the author bio), not
      // the page bottom, so content placed after the article (related reading)
      // does not lower the numbers. 100% means the bottom of the article is in view.
      function checkDepth() {
        var scrollTop = window.scrollY || document.documentElement.scrollTop;
        var articleBottom = articleEl.getBoundingClientRect().bottom + scrollTop;
        // Rounded down: element positions are fractional but scroll positions are
        // whole pixels, so an unrounded target can leave a finished read at 99.9%.
        var target = Math.floor(articleBottom - window.innerHeight);
        if (target <= 0) return;
        var pct = (scrollTop / target) * 100;
        thresholds.forEach(function (t) {
          if (pct >= t && !seen.has(t)) {
            seen.add(t);
            if (typeof gtag === "function") {
              gtag("event", "article_read_depth", {
                article_slug: slug,
                depth_percent: t,
              });
            }
          }
        });
      }

      window.addEventListener("scroll", checkDepth, { passive: true });
      checkDepth();
    })();
  </script>
  <TrackClicks />
</body>
</html>
