---
// Week 1 placeholder pages for the offers. The full offer pages are built in
// Week 2. Stubs are noindex and stay out of the sitemap until then.
import Analytics from "../components/Analytics.astro";
import SiteNav from "../components/SiteNav.astro";
import TrackClicks from "../components/TrackClicks.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
}
const { title, description, eyebrow, heading } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <Analytics />
  <meta charset="UTF-8">
  <meta name="color-scheme" content="dark">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Reginal Campbell">
  <meta name="robots" content="noindex, follow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body class="antialiased">
  <a href="#stub-main" class="skip-link">Skip to main content</a>
  <SiteNav active="engage" />
  <main id="stub-main" style="max-width:920px;margin:0 auto;padding:calc(var(--nav-height, 64px) + 48px) 24px 96px;">
    <header class="mb-10">
      <span class="text-amber-400 font-mono text-sm uppercase tracking-wider">{eyebrow}</span>
      <h1 class="text-3xl md:text-4xl font-bold mt-2">{heading}</h1>
    </header>
    <slot />
    <div class="mt-12 border-t border-white/10 pt-8 flex flex-wrap gap-4">
      <a href="/#contact" data-ga-event="engage_contact_click" data-ga-source={eyebrow} class="px-6 py-3 rounded-full bg-amber-400 text-black font-bold hover:bg-amber-300 transition inline-flex items-center gap-2">
        Start the conversation <i aria-hidden="true" class="fas fa-arrow-right text-sm"></i>
      </a>
      <a href="/" class="px-6 py-3 rounded-full border border-white/20 text-white font-medium hover:bg-white/5 transition inline-flex items-center gap-2">Back to home</a>
    </div>
  </main>
  <TrackClicks />
</body>
</html>
