---
import Analytics from "../components/Analytics.astro";
import SiteNav from "../components/SiteNav.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lastReviewed: Date;
  version: string;
  ogImage: string;
  ogImageAlt: string;
  slug: string;
  canonical?: string;
  anchorScenario?: "leadership-agent" | "helios";
}

const { title, description, lastReviewed, version, ogImage, ogImageAlt, slug, canonical, anchorScenario } = Astro.props;

// anchorScenario cross-link, deferred from Phase A to Phase D because nothing
// rendered until a real anchor existed. Only leadership-agent is mapped; helios
// lands in Phase E and targets a different homepage section (#case-study, the
// Project Helios downloads), not this one. An unmapped value renders nothing
// rather than a broken link.
const ANCHOR_SCENARIOS = {
  "leadership-agent": {
    href: "/#ai-systems",
    label: "The Leadership Agent",
    context: "This assessment is anchored on a real system. Read the architecture case study",
  },
} as const;

const anchor =
  anchorScenario && anchorScenario in ANCHOR_SCENARIOS
    ? ANCHOR_SCENARIOS[anchorScenario as keyof typeof ANCHOR_SCENARIOS]
    : undefined;

// Non-trailing-slash form, per the locked URL decision. Vercel serves these
// routes with a 200 directly, so the canonical must not carry a trailing slash.
const pageUrl = new URL(`/artifacts/${slug}`, Astro.site).toString();
const canonicalUrl = canonical ?? pageUrl;
const absoluteOgImage = new URL(ogImage, Astro.site).toString();
const pageTitle = `${title} — Reginal Campbell`;
const reviewedISO = lastReviewed.toISOString();
const reviewedDisplay = lastReviewed.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// CreativeWork rather than BlogPosting: these are reference material, not posts.
// dateModified maps from lastReviewed and there is deliberately no datePublished —
// lastReviewed replaces pubDate entirely for artifacts.
const creativeWorkJsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: title,
  description,
  image: absoluteOgImage,
  dateModified: reviewedISO,
  version,
  url: pageUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": pageUrl,
  },
  author: {
    "@id": "https://reginalcampbell.com/#person",
  },
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <Analytics />
  <meta charset="UTF-8">
  <meta name="color-scheme" content="dark">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Reginal Campbell">
  <link rel="canonical" href={canonicalUrl}>
  <meta name="robots" content="index, follow">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="article">
  <meta property="og:url" content={pageUrl}>
  <meta property="og:image" content={absoluteOgImage}>
  <meta property="og:image:alt" content={ogImageAlt}>
  <meta property="article:modified_time" content={reviewedISO}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={absoluteOgImage}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(creativeWorkJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body class="antialiased">
  <a href="#artifact-main" class="skip-link">Skip to main content</a>

  <SiteNav active="governance" />

  <main id="artifact-main" style="max-width:860px;margin:0 auto;padding:calc(var(--nav-height, 64px) + 48px) 24px 96px;">
    <article id="artifact-content-body" data-slug={slug}>
      <header class="mb-10">
        <p class="text-neutral-500 text-xs font-mono uppercase tracking-widest">
          Governance Artifact · Last reviewed {reviewedDisplay} · v{version}
        </p>
        <h1 class="text-3xl md:text-4xl font-bold mt-3">{title}</h1>
        <p class="text-neutral-400 text-sm mt-4 leading-relaxed border-l-2 border-amber-500/40 pl-4">
          This artifact is a worked example of applied governance
          practice. It is not legal advice and should not be relied on as a compliance
          determination for any specific system or organization.
        </p>
      </header>
      <div class="prose-article prose-artifact">
        <slot />
      </div>
      <footer class="mt-16 pt-6 border-t border-white/10">
        {anchor && (
          <p class="text-neutral-400 text-sm leading-relaxed mb-6">
            {anchor.context}: <a href={anchor.href} class="text-amber-400 hover:underline">{anchor.label}</a>.
          </p>
        )}
        <a href="/artifacts" class="text-amber-400 text-sm font-mono hover:underline">&larr; All governance artifacts</a>
      </footer>
    </article>
  </main>

  <script is:inline>
    (function () {
      var seen = new Set();
      var thresholds = [25, 50, 75, 100];
      var artifactEl = document.getElementById("artifact-content-body");
      if (!artifactEl) return;
      var slug = artifactEl.getAttribute("data-slug");

      function checkDepth() {
        var scrollTop = window.scrollY || document.documentElement.scrollTop;
        var docHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (docHeight <= 0) return;
        var pct = (scrollTop / docHeight) * 100;
        thresholds.forEach(function (t) {
          if (pct >= t && !seen.has(t)) {
            seen.add(t);
            if (typeof gtag === "function") {
              gtag("event", "artifact_read_depth", {
                artifact_slug: slug,
                depth_percent: t,
              });
            }
          }
        });
      }

      window.addEventListener("scroll", checkDepth, { passive: true });
      checkDepth();
    })();
  </script>
</body>
</html>
