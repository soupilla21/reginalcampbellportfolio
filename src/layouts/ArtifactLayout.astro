---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lastReviewed: Date;
  version: string;
  slug: string;
}

const { title, description, lastReviewed, version, slug } = Astro.props;

const pageTitle = `${title} — Reginal Campbell`;
const reviewedDisplay = lastReviewed.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-32FSF2EFEW"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-32FSF2EFEW');
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Reginal Campbell">
  <meta name="robots" content="index, follow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body class="antialiased">
  <a href="#artifact-main" class="skip-link">Skip to main content</a>

  <nav id="main-nav" aria-label="Main navigation">
    <div class="inner">
      <div class="flex items-center gap-2 min-w-0">
        <a href="/" class="text-lg font-bold tracking-tight bg-gradient-to-r from-white to-gray-400 bg-clip-text text-transparent whitespace-nowrap">REGINAL CAMPBELL</a>
        <span class="hidden md:inline text-neutral-500 font-mono text-sm">|</span>
        <span class="hidden md:inline text-sm font-mono text-neutral-400 truncate">AI &amp; Data Strategy</span>
      </div>
      <div class="flex items-center gap-5 text-sm font-medium flex-shrink-0">
        <a href="/#case-study" class="nav-link">Work</a>
        <a href="/#delivery-portfolio" class="nav-link">Portfolio</a>
        <a href="/#governance" class="nav-link nav-active">Governance</a>
        <a href="/#innovation-lab" class="nav-link">Lab</a>
        <a href="/#point-of-view" class="nav-link">POV</a>
        <a href="/articles" class="nav-link">Articles</a>
        <a href="/#contact" class="nav-link">Contact</a>
        <a href="https://briefing.reginalcampbell.com" class="nav-link">Ask the AI</a>
      </div>
    </div>
  </nav>

  <main id="artifact-main" style="max-width:860px;margin:0 auto;padding:calc(var(--nav-height, 64px) + 48px) 24px 96px;">
    <article id="artifact-content-body" data-slug={slug}>
      <header class="mb-10">
        <p class="text-neutral-500 text-xs font-mono uppercase tracking-widest">
          Governance Artifact · Last reviewed {reviewedDisplay} · v{version}
        </p>
        <h1 class="text-3xl md:text-4xl font-bold mt-3">{title}</h1>
        <p class="text-neutral-400 text-sm mt-4 leading-relaxed border-l-2 border-amber-500/40 pl-4">
          This artifact is illustrative and is provided as an example of applied governance
          practice. It is not legal advice and should not be relied on as a compliance
          determination for any specific system or organization.
        </p>
      </header>
      <div class="prose-article">
        <slot />
      </div>
      <footer class="mt-16 pt-6 border-t border-white/10">
        <a href="/artifacts" class="text-amber-400 text-sm font-mono hover:underline">&larr; All governance artifacts</a>
      </footer>
    </article>
  </main>
</body>
</html>
