{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/ask", "destination": "/ask/", "permanent": true },
    { "source": "/articles/why-this-platform-exists", "destination": "/articles", "permanent": true }
  ],
  "rewrites": [
    { "source": "/ask/", "destination": "https://portfolio-intelligence-bot.netlify.app/" },
    { "source": "/ask/:path+", "destination": "https://portfolio-intelligence-bot.netlify.app/:path+" }
  ]
}
