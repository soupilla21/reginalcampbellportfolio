{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/ask",
      "destination": "/ask/",
      "permanent": true
    },
    {
      "source": "/articles/why-this-platform-exists",
      "destination": "/articles",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/clients/tia-brown",
      "destination": "https://tig-brown-coaching-portal.vercel.app/clients/tia-brown/index.html"
    },
    {
      "source": "/clients/tia-brown/",
      "destination": "https://tig-brown-coaching-portal.vercel.app/clients/tia-brown/index.html"
    },
    {
      "source": "/clients/tia-brown/:path*/",
      "destination": "https://tig-brown-coaching-portal.vercel.app/clients/tia-brown/:path*/index.html"
    },
    {
      "source": "/clients/tia-brown/:path*",
      "destination": "https://tig-brown-coaching-portal.vercel.app/clients/tia-brown/:path*"
    },
    {
      "source": "/ask/",
      "destination": "https://portfolio-intelligence-bot.netlify.app/"
    },
    {
      "source": "/ask/:path+",
      "destination": "https://portfolio-intelligence-bot.netlify.app/:path+"
    }
  ],
  "headers": [
    {
      "source": "/advisory/first-90-days/files/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
